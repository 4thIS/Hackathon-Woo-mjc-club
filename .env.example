# cp .env.example .env  후 값을 채운다. .env 는 커밋 금지 (CLAUDE.md §금지)

# --- DB ---------------------------------------------------------------
POSTGRES_USER=mjc
POSTGRES_PASSWORD=mjc
POSTGRES_DB=mjcclub
# 로컬에서 앱만 띄울 때 backend/.env 에 넣는 값
DATABASE_URL=postgresql+psycopg://mjc:mjc@localhost:5432/mjcclub

# --- 보안 -------------------------------------------------------------
# 세션 쿠키 서명 + AI 키 암호화에 함께 쓴다. 아무 긴 문자열이면 된다.
# ★ 이 값을 바꾸면 저장된 AI 키를 복호화할 수 없다 (재등록 필요)
SECRET_KEY=change-me-to-a-long-random-string

# --- URL --------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- 메일 (비워두면 콘솔에 인증 링크를 출력한다) -----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mjc.ac.kr

# --- 명지전문대학 AI Gateway ------------------------------------------
# 사용자 개인 키는 여기 넣지 않는다. 각자 '내 정보'에서 등록한다 (기획서 §4.5)
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_MODEL=claude-sonnet-5

# 1이면 게이트웨이를 호출하지 않고 준비된 초안을 반환한다 (시연 폴백)
DEMO_FALLBACK=0
