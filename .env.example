# cp .env.example .env  후 값을 채운다. .env 는 커밋 금지 (CLAUDE.md §금지)
#
# 이 파일 하나면 된다 — 저장소 루트의 .env 를 개발 실행과 docker compose 가 함께 읽는다.
# (backend/.env 를 따로 두면 그쪽이 우선한다)

# --- DB ---------------------------------------------------------------
POSTGRES_USER=mjc
POSTGRES_PASSWORD=mjc
POSTGRES_DB=mjcclub
# 로컬에서 앱만 띄울 때 쓰는 접속 주소 (도커 전체 실행 때는 compose 가 덮어쓴다)
DATABASE_URL=postgresql+psycopg://mjc:mjc@localhost:5432/mjcclub

# --- 보안 -------------------------------------------------------------
# 세션 쿠키 서명 + AI 키 암호화에 함께 쓴다. 아무 긴 문자열이면 된다.
# ★ 이 값을 바꾸면 저장된 AI 키를 복호화할 수 없다 (재등록 필요)
SECRET_KEY=change-me-to-a-long-random-string

# --- URL --------------------------------------------------------------
# 인증 메일의 링크가 이 주소를 기준으로 만들어진다.
# 여기 값은 **개발 서버(:5173)용**이다. 도커 전체 실행은 compose 가 :8080 을 쓰므로
# 이 값을 도커에 맞춰 고칠 필요가 없다 (바꾸려면 DOCKER_FRONTEND_URL).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# API 가 프론트와 다른 호스트에 있을 때만 채운다. 비우면 FRONTEND_URL 을 쓴다.
PUBLIC_BASE_URL=

# --- 메일 --------------------------------------------------------------
# 비워두면 메일을 보내지 않고 인증 링크를 콘솔에 출력한다 (서버는 정상 동작).
#
# Gmail 로 실제 발송하려면:
#   1. Google 계정 → 보안 → 2단계 인증을 켠다
#   2. '앱 비밀번호'를 발급받는다 (16자리, 공백 없이 붙여 쓴다)
#   3. 아래를 채운다. 계정 비밀번호로는 로그인되지 않는다.
#
# SMTP_FROM 은 비워 두는 것을 권장한다 — Gmail 은 인증한 계정과 다른 발신자를
# 허용하지 않으므로, 비어 있으면 SMTP_USER 를 발신 주소로 쓴다.
#
# 설정을 바꾼 뒤에는 회원가입 없이 확인할 수 있다:
#   cd backend && uv run python check_mail.py --to 본인학번@mjc.ac.kr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=MJC Club Archive

# --- 명지전문대학 AI Gateway ------------------------------------------
# 사용자 개인 키는 여기 넣지 않는다. 각자 '내 정보'에서 등록한다 (기획서 §4.5)
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_MODEL=claude-sonnet-5

# 1이면 게이트웨이를 호출하지 않고 준비된 초안을 반환한다 (시연 폴백)
DEMO_FALLBACK=0
